[Unit]
Description=Misskey auto renoter
After=network.target

[Service]
WorkingDirectory=/home/your-user/MiChannelAutoRenoter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/your-user/MiChannelAutoRenoter/main.py
Restart=always
RestartSec=10
User=your-user
Group=your-user

[Install]
WantedBy=multi-user.target
